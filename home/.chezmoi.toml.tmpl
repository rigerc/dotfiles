{{- /* Prompts save only machine-local choices; never commit the generated config. */ -}}
{{- $name := promptStringOnce . "gitName" "Git author name" -}}
{{- $email := promptStringOnce . "gitEmail" "Git author email" -}}
{{- $machine := promptChoiceOnce . "machineType" "Machine type" (list "personal" "work") "personal" -}}
{{- $role := promptChoiceOnce . "machineRole" "Machine role" (list "desktop" "laptop" "chromebook" "server") "desktop" -}}
{{- $profileDefault := "desktop" -}}
{{- if eq $role "server" -}}{{- $profileDefault = "core" -}}{{- end -}}
{{- $profile := promptChoiceOnce . "packageProfile" "Arch package profile: core, desktop, or developer" (list "core" "desktop" "developer") $profileDefault -}}
{{- $install := promptBoolOnce . "installPackages" "Install missing pacman packages? This performs pacman -Syu (system upgrade)" false -}}
{{- $herdr := promptBoolOnce . "installHerdr" "Install Herdr using its official stable installer and auto-attach in SSH Fish logins?" false -}}
{{- $sshd := promptBoolOnce . "enableSshd" "Configure and enable SSH access for this user from private LAN addresses (sudo required)?" false -}}
{{- $tune := false -}}
{{- if eq $role "chromebook" -}}
{{- $tune = promptBoolOnce . "chromebookTuning" "Enable automatic Chromebook zram, memory and journal tuning (requires sudo)?" false -}}
{{- end -}}
# Local-only file created by chezmoi init. Never commit your rendered config.
sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
    gitName = {{ $name | quote }}
    gitEmail = {{ $email | quote }}
    machineType = {{ $machine | quote }}
    machineRole = {{ $role | quote }}
    packageProfile = {{ $profile | quote }}
    installPackages = {{ $install }}
    installHerdr = {{ $herdr }}
    enableSshd = {{ $sshd }}
    chromebookTuning = {{ $tune }}
