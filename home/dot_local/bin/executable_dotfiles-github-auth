#!/usr/bin/env bash
# Interactive, machine-local authentication; never run during chezmoi rendering.
set -euo pipefail
umask 077
prompt_title='' prompt_accent='' prompt_reset=''
if [[ -t 2 && -n ${TERM:-} && ${TERM:-} != dumb && -z ${NO_COLOR:-} ]]; then
    prompt_title=$'\e[1;36m' prompt_accent=$'\e[1m' prompt_reset=$'\e[0m'
fi
section() { printf '\n%s%s%s\n' "$prompt_title" "$*" "$prompt_reset" >&2; }
ask() {
    local answer
    printf '\n' >&2
    while true; do
        printf '  %s%s%s [y/N]: ' "$prompt_accent" "$1" "$prompt_reset" >&2
        if ! read -r answer; then printf '\n' >&2; return 1; fi
        case ${answer,,} in
            y|yes) return 0 ;;
            ''|n|no) return 1 ;;
            *) printf '  Enter yes or no; press Enter to skip.\n' >&2 ;;
        esac
    done
}
if [[ ${1:-} == --help ]]; then
    echo 'Usage: dotfiles-github-auth [PATH_TO_PRIVATE_KEY]'
    echo 'Log in to GitHub.com via browser/device flow and offer SSH key registration.'
    exit 0
fi
(($# <= 1)) || { echo 'Expected at most one private-key path.' >&2; exit 1; }
[[ -t 0 && -t 1 ]] || { echo 'Run this command in an interactive terminal.' >&2; exit 1; }
for tool in gh ssh-keygen; do
    command -v "$tool" >/dev/null || { echo "Install $tool first." >&2; exit 1; }
done
# Environment tokens would override device authentication and its stored identity.
if [[ -n ${GH_TOKEN:-}${GITHUB_TOKEN:-} ]]; then
    echo 'Unset GH_TOKEN/GITHUB_TOKEN for persistent browser/device authentication.' >&2
    exit 1
fi
# ssh-key subcommands use GH_HOST rather than a --hostname flag.
export GH_HOST=github.com
section '[1/3] GitHub login'
echo '  GitHub.com account; Git operations will use SSH.'
if ! gh auth status --hostname github.com >/dev/null 2>&1; then
    echo '  Follow the device-login link below; a browser on another machine works too.'
    gh auth login --hostname github.com --web --git-protocol ssh --skip-ssh-key
else
    echo '  Reusing your existing GitHub login.'
fi
gh config set git_protocol ssh --host github.com

section '[2/3] SSH identity'
key=${1:-}
if [[ -z $key ]]; then
    # Prefer existing standard keys; accept a custom identity as the argument.
    for candidate in "$HOME/.ssh/id_ed25519" "$HOME/.ssh/id_ecdsa" "$HOME/.ssh/id_rsa"; do
        if [[ -f $candidate ]]; then key=$candidate; break; fi
    done
    key=${key:-$HOME/.ssh/id_ed25519}
fi
if [[ ! -f $key ]]; then
    # Never overwrite an orphan public key or create a key at a mistyped custom path.
    [[ $# == 0 && ! -e $key && ! -e $key.pub ]] || {
        echo "No private key at $key; resolve the existing path or create it manually." >&2; exit 1;
    }
    printf '  New key location: %s\n' "$key"
    echo '  You will choose a passphrase in ssh-keygen.'
    if ! ask 'Generate an Ed25519 key for this machine?'; then
        echo '  GitHub login is ready. SSH key setup skipped; rerun this helper later.'
        exit 0
    fi
    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"
    # ssh-keygen prompts for a passphrase; no secret enters argv or the repository.
    ssh-keygen -t ed25519 -f "$key" -C "$(id -un)@$(hostname)"
fi
printf '  Selected key: %s\n' "$key"
section '[3/3] Public key registration'
echo '  Uploads only the public key; your private key stays on this machine.'
if ! ask 'Register this key with your GitHub account?'; then
    echo '  Registration skipped. Git over SSH requires a key already registered with GitHub.'
    exit 0
fi
public_key=$(mktemp)
trap 'rm -f -- "$public_key"' EXIT
# Derive the public key from the selected private key, avoiding stale .pub files.
ssh-keygen -y -f "$key" > "$public_key"
gh auth refresh --hostname github.com --scopes admin:public_key
gh ssh-key add "$public_key" --type authentication --title "$(id -un)@$(hostname)"
section 'GitHub setup finished'
printf '  GitHub uses SSH. Selected key: %s\n' "$key"
echo 'For a custom key, set IdentityFile in ~/.ssh/config.d/github.conf.'
echo 'If passphrase-protected, load it into your existing agent with ssh-add.'
